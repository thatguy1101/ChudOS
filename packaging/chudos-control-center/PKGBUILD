# Maintainer: ChudOS Project
pkgname=chudos-control-center
pkgver=0.1.0
pkgrel=1
pkgdesc='ChudOS Control Centre'
arch=('any')
url='https://example.invalid/chudos'  # TODO(project): replace once a public home exists
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'chudos-profiles' 'chudos-monitor' 'systemsettings')
optdepends=('pacman-contrib: update checks' 'konsole: terminal shortcuts')
options=('!strip')

package() {
  local root="${startdir}/../.."
  local app="${root}/applications/chudos-control-center"
  install -d "${pkgdir}/usr/lib/chudos/control-center"
  cp -a "${app}/chudos_control_center" "${pkgdir}/usr/lib/chudos/control-center/"
  find "${pkgdir}/usr/lib/chudos/control-center" -name '__pycache__' -prune -exec rm -rf {} +
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/chudos-control-center" <<'LAUNCH'
#!/bin/sh
PYTHONPATH=/usr/lib/chudos/control-center:/usr/lib/chudos/monitor:/usr/lib/chudos/profiles-engine${PYTHONPATH:+:$PYTHONPATH} exec /usr/bin/python3 -m chudos_control_center "$@"
LAUNCH
  install -Dm644 "${app}/chudos-control-center.desktop" "${pkgdir}/usr/share/applications/chudos-control-center.desktop"
}
